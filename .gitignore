# Environment configuration and local secrets
.env
.env.*
!.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example
/frontend/.env.local
/frontend/.env.*.local

# Dependencies
/backend/vendor/
/frontend/node_modules/

# Build output and generated frontend files
/frontend/dist/
/frontend/dist-ssr/
/backend/public/build/
/backend/public/hot
/backend/public/storage

# Local databases and database sidecars
/database/*.sqlite
/database/*.sqlite-*
/backend/database/*.sqlite
/backend/database/*.sqlite-*

# Laravel runtime files
/backend/bootstrap/cache/*.php
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*.log
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/auth.json

# Logs and operating-system files
*.log
.DS_Store
Thumbs.db
